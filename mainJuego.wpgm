import direcciones.*
import wollok.game.*
import juego.*

object config {

    method configurarEscenario() {
        game.title("El Preso")
        game.height(11)
        game.width(11)
        game.cellSize(64)
    }
}

program ElPreso {

    config.configurarEscenario()

    tablero.mostrar()

    const selector = new Selector(position = game.at(1, 6))
    const jugador1 = new Jugador()

    game.addVisual(selector)
    dados.mostrar()
    game.addVisual(jugador1)

    keyboard.right().onPressDo {
        selector.moverDerecha()
    }

    keyboard.left().onPressDo {
        selector.moverIzquierda()
    }

    keyboard.space().onPressDo {
        tablero.elegir(selector.numeroSeleccionado(), dados.puntaje())
        game.removeVisual(selector)
        game.addVisual(selector)
    }

    keyboard.g().onPressDo {
    dados.tirar()
    tablero.habilitarJugada()
}
    keyboard.p().onPressDo {
    tablero.confirmarJugada()
}

    keyboard.c().onPressDo {
        tablero.cancelarSeleccion()
    }

    keyboard.t().onPressDo {
        tablero.levantasRejas()
    }
    keyboard.f().onPressDo{tablero.terminarTurno(jugador1)}

    game.start()
}