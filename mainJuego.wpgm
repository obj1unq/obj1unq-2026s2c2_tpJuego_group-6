import wollok.game.*
import jugadores.*
import elementos.*
import tablero.*
import configuracion.*

object config {

    method configurarEscenario() {
        game.title("El Preso")
        game.height(11)
        game.width(11)
        game.cellSize(64)
    }
}

program ElPreso {

    config.configurarEscenario()

    // tablero.mostrar()

    game.addVisual(pantallaInicioVisual)

    // const jugador1 = new Jugador()
	// const puntaje = new Puntaje(jugador = jugador1)
    // dados.mostrar()
    // game.addVisual(jugador1)
	// game.addVisual(puntaje)

    // Controles de menús
    keyboard.enter().onPressDo {
        if (juego.estado() != "JUGANDO") juego.avanzarEstado()
    }

    keyboard.up().onPressDo {
        if (juego.estado() == "SELECCION_JUGADORES") juego.incrementarJugadores()
        else if (juego.estado() == "SELECCION_PUNTAJE") juego.siguientePuntaje()
    }

    keyboard.down().onPressDo {
        if (juego.estado() == "SELECCION_JUGADORES") juego.decrementarJugadores()
        else if (juego.estado() == "SELECCION_PUNTAJE") juego.anteriorPuntaje()
    }

   // Controles dentro del juego
    keyboard.right().onPressDo {
        if (juego.estado() == "JUGANDO") selector.moverDerecha()
    }

    keyboard.left().onPressDo {
        if (juego.estado() == "JUGANDO") selector.moverIzquierda()
    }

    keyboard.space().onPressDo {
        if (juego.estado() == "JUGANDO") {
            tablero.elegir(selector.numeroSeleccionado(), dados.puntaje())
        }
    }

    keyboard.g().onPressDo {
        if (juego.estado() == "JUGANDO") {
            dados.tirar()
            tablero.habilitarJugada()
        }
    }

    keyboard.p().onPressDo {
        if (juego.estado() == "JUGANDO") {
            tablero.confirmarJugada(juego.jugadorActual())
            juego.pasarTurno()
        }
    }

    keyboard.c().onPressDo {
        if (juego.estado() == "JUGANDO") {
            tablero.cancelarSeleccion()
            tablero.habilitarJugada()
        }
    }

    keyboard.t().onPressDo {
        if (juego.estado() == "JUGANDO") {
            tablero.levantasRejas()
        }
    }

    game.start()
}