import wollok.game.*
import juego.*

object config {

    method configurarEscenario() {
        game.title("El Preso")
        game.height(11)
        game.width(11)
        game.cellSize(64)
    }
}



program ElPreso {

    config.configurarEscenario()

	tablero.mostrar()
	
	const selector = new Selector(
		position = game.origin().right(1).up(6)
	)
	//const selector = new Selector(position = game.at(1, 6)) no seria mejor este para el de arriba?
	const jugador1 = new Jugador()

	game.addVisual(selector)
	game.addVisual(dadoAleatorio1)
	game.addVisual(jugador1)
	game.addVisual(dadoAleatorio2)

	keyboard.right().onPressDo {
		selector.moverDerecha()
	}

	
	//---------------------------------------------------
	//cambios que se podria agregar?
	//keyboard.right().onPressDo({selector.avanzar()})
	//keyboard.left().onPressDo({selector.retroceder()})
	//---------------------------------------------------

	keyboard.left().onPressDo {
		selector.moverIzquierda()
	}


	keyboard.space().onPressDo {
		tablero.alternarCelda(selector.numeroSeleccionado())
		game.removeVisual(selector)
   		game.addVisual(selector)
	}

	keyboard.g().onPressDo{dadoAleatorio1.tirarDados()} //agregue esta tecla para probar el dado
	keyboard.t().onPressDo({tablero.levantasRejas()}) //solo levanta las rejas si todas estan cerradas
	keyboard.g().onPressDo{dadoAleatorio2.tirarDados()}



    game.start()
}